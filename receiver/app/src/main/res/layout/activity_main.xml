<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg">

    <!-- Capa 1: Superficie de vídeo a pantalla completa -->
    <SurfaceView
        android:id="@+id/video_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Capa 2: Interfaz Minimalista de Espera (Standby) -->
    <LinearLayout
        android:id="@+id/standby_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/tv_bg_minimal"
        android:padding="48dp">

        <!-- Marca y Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Linky"
            android:textStyle="bold"
            android:textSize="44sp"
            android:letterSpacing="-0.02"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/status_idle"
            android:textSize="17sp"
            android:textColor="@color/tv_text_secondary" />

        <!-- Píldora de Conexión y Red (Datos Esenciales) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pill_status_minimal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginTop="32dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/tv_dot_active" />

            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Android TV"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="·"
                android:textColor="@color/tv_text_muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_device_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.1.xxx"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textColor="@color/tv_text_secondary" />
        </LinearLayout>

        <!-- Botones de Acción (Navegación horizontal fluida con D-Pad) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="36dp">

            <!-- Botón de Estado / Encendido -->
            <Button
                android:id="@+id/btn_power"
                android:layout_width="180dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_tv_minimal"
                android:text="@string/power_off"
                android:textColor="@color/btn_tv_minimal_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="14dp" />

            <!-- Botón Modo AirPlay -->
            <Button
                android:id="@+id/btn_airplay"
                android:layout_width="180dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_tv_minimal"
                android:text="@string/btn_airplay"
                android:textColor="@color/btn_tv_minimal_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginStart="14dp" />
        </LinearLayout>

        <!-- Switch de Auto-inicio Minimalista -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/boot_auto_start"
                android:textColor="@color/tv_text_muted"
                android:textSize="14sp"
                android:layout_marginEnd="12dp" />

            <Switch
                android:id="@+id/switch_boot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>

        <!-- Indicación inferior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Ejecuta linky-stream en tu PC Linux para duplicar pantalla"
            android:textColor="@color/tv_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Capa 3: Overlay / HUD de Métricas Minimalista -->
    <LinearLayout
        android:id="@+id/hud_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="28dp"
        android:background="@drawable/hud_minimal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/hud_codec_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEVC HW · 1080p60"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/hud_stats_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="8.5 Mbps · 0 NACKs"
            android:textSize="12sp"
            android:textColor="@color/tv_text_secondary" />
    </LinearLayout>

    <!-- Capa 4: Diálogo Modal Minimalista de Autorización -->
    <FrameLayout
        android:id="@+id/request_dialog_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_scrim"
        android:gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/card_minimal"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitud de Conexión"
                android:textStyle="bold"
                android:textSize="22sp"
                android:letterSpacing="-0.01"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/request_dialog_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/request_dialog_msg"
                android:textSize="15sp"
                android:textColor="@color/tv_text_secondary"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="28dp">

                <Button
                    android:id="@+id/btn_accept"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_tv_minimal"
                    android:text="@string/request_accept"
                    android:textColor="@color/btn_tv_minimal_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_deny"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_tv_minimal"
                    android:text="@string/request_deny"
                    android:textColor="@color/btn_tv_minimal_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
