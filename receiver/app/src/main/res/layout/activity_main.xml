<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Capa 1: Superficie de vídeo a pantalla completa -->
    <SurfaceView
        android:id="@+id/video_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Capa 2: Interfaz de espera (Standby UI) -->
    <ScrollView
        android:id="@+id/standby_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tv_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="36dp"
            android:paddingBottom="36dp">

            <!-- Cabecera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LINKY STREAM"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        android:letterSpacing="0.05"
                        android:textColor="@color/tv_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_subtitle"
                        android:textSize="14sp"
                        android:textColor="@color/tv_text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Estado del receptor -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_tv"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/tv_status_active" />

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/status_idle"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/tv_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Contenedor central dividido en columnas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="28dp">

                <!-- Columna Izquierda: Información de Conexión -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_tv"
                    android:padding="20dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_info_title"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/tv_text_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="130dp"
                            android:layout_height="wrap_content"
                            android:text="@string/device_name_label"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_device_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Android TV"
                            android:textStyle="bold"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="130dp"
                            android:layout_height="wrap_content"
                            android:text="@string/device_ip_label"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_device_ip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="192.168.1.xxx"
                            android:textStyle="bold"
                            android:textColor="@color/accent"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Servicio anunciado por mDNS (_linky._tcp) en puerto 61032."
                        android:textColor="@color/tv_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Columna Derecha: Acciones y Modos -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_tv"
                    android:padding="20dp"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opciones del Receptor"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/tv_text_primary" />

                    <!-- Botón Encender / Apagar Servicio -->
                    <Button
                        android:id="@+id/btn_power"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/btn_tv_primary"
                        android:text="@string/power_off"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <!-- Botón Modo AirPlay -->
                    <Button
                        android:id="@+id/btn_airplay"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_tv_airplay"
                        android:text="@string/btn_airplay"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <!-- Switch Auto-inicio al encender el TV -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/boot_auto_start"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="14sp" />

                        <Switch
                            android:id="@+id/switch_boot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Sección Inferior: Guía Rápida para el Usuario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_tv"
                android:padding="16dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instructions_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/tv_text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/instructions_desc"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Capa 3: Overlay / HUD de Diagnóstico en Tiempo Real -->
    <LinearLayout
        android:id="@+id/hud_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/hud_background"
        android:padding="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hud_title"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/hud_codec_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Códec: HEVC HW"
            android:textSize="13sp"
            android:textColor="@color/tv_text_primary" />

        <TextView
            android:id="@+id/hud_stats_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Resolución: 1080p | 60 FPS"
            android:textSize="13sp"
            android:textColor="@color/tv_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/hud_toggle_hint"
            android:textSize="11sp"
            android:textColor="@color/tv_text_muted" />
    </LinearLayout>

    <!-- Capa 4: Diálogo Modal de Solicitud de Transmisión (D-Pad Friendly) -->
    <FrameLayout
        android:id="@+id/request_dialog_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_scrim"
        android:gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/card_tv"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/request_dialog_title"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/tv_text_primary" />

            <TextView
                android:id="@+id/request_dialog_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/request_dialog_msg"
                android:textSize="16sp"
                android:textColor="@color/tv_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/btn_accept"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_tv_primary"
                    android:text="@string/request_accept"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_deny"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_tv_danger"
                    android:text="@string/request_deny"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
